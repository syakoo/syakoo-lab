{
  "name": "syakoo-lab",
  "type": "module",
  "version": "6.10.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.22.0"
  },
  "scripts": {
    "prepare": "git rev-parse --is-inside-work-tree > /dev/null 2>&1 && git config --local include.path ../.githooks || true",
    "dev": "run-p dev:*",
    "dev:local": "pnpm run build:seo-files && waku dev",
    "build": "pnpm run build:og-images && pnpm run build:seo-files && pnpm run build:waku",
    "build:waku": "waku build",
    "build:seo-files": "tsx --tsconfig ./tsconfig.json --import ./scripts/register-image-loader.mjs ./scripts/generate-seo-files.ts",
    "build:og-images": "tsx --tsconfig ./tsconfig.json ./scripts/generate-og-images.ts",
    "build:optimize-image": "tsx --env-file=.env.local --tsconfig ./tsconfig.json ./scripts/optimize-image.ts",
    "start": "pnpm run build:seo-files && waku start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:clear": "vitest run --reporter=verbose --clearCache",
    "test:update": "vitest run -u",
    "format": "biome format --write .",
    "lint": "biome check . && pnpm check:architecture",
    "lint:fix": "biome check --write .",
    "check:architecture": "tsx --tsconfig ./tsconfig.json ./scripts/check-architecture.ts",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:serve": "pnpm exec http-server storybook-static -a 127.0.0.1 -p 6006 -s",
    "storybook:test": "test-storybook --url http://127.0.0.1:6006",
    "storybook:test:ci": "concurrently -k -s first \"pnpm storybook:serve\" \"wait-on http://127.0.0.1:6006 && pnpm storybook:test\"",
    "storybook:test:vrt:update": "bash ./scripts/update-vrt-baselines.sh",
    "storybook:test:vrt:update:host": "test-storybook --url http://127.0.0.1:6006 --excludeTags skip-vrt --updateSnapshot",
    "storybook:test:vrt:update:ci": "concurrently -k -s first \"pnpm storybook:serve\" \"wait-on http://127.0.0.1:6006 && pnpm storybook:test:vrt:update:host\"",
    "generate": "scaffdog generate"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/roboto": "^5.3.0",
    "@mdx-js/mdx": "^3.1.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/postcss": "^4.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.0.0",
    "glob": "^14.0.0",
    "gray-matter": "^4.0.3",
    "mermaid": "^12.0.0",
    "probe-image-size": "^7.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.0",
    "shiki": "^4.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "ts-pattern": "^5.7.1",
    "waku": "0.27.5",
    "zod": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "core-js-pure",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "axios": "^1.15.0",
      "jest": "30.4.2",
      "jest-circus": "30.4.2",
      "jest-runner": "30.4.2",
      "jest-environment-node": "30.4.1",
      "@jest/types": "30.4.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-links": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@storybook/test-runner": "^0.24.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/gtag.js": "^0.0.20",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/probe-image-size": "^7.2.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "axe-playwright": "^2.1.0",
    "concurrently": "^10.0.0",
    "http-server": "^14.1.1",
    "jest-image-snapshot": "^6.5.2",
    "jsdom": "^30.0.0",
    "npm-run-all2": "^9.0.0",
    "playwright": "^1.55.0",
    "scaffdog": "^4.0.0",
    "storybook": "^10.6.3",
    "tsx": "^4.20.5",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "wait-on": "^9.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
