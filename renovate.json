{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", ":timezone(Asia/Tokyo)"],
  "schedule": ["every weekend"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "1 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch updates",
      "automerge": true
    },
    {
      "description": "Vite toolchain majors move together",
      "matchPackageNames": ["vite", "vitest", "@vitejs/plugin-react"],
      "matchUpdateTypes": ["major"],
      "groupName": "vite toolchain"
    },
    {
      "description": "jsdom and its types move together",
      "matchPackageNames": ["jsdom", "@types/jsdom"],
      "matchUpdateTypes": ["major"],
      "groupName": "jsdom"
    }
  ]
}
